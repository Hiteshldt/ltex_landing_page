# Copy this file to .env.local and fill in real values (do NOT commit .env.local).

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form leads are delivered (comma-separated for multiple inboxes).
CONTACT_TO=leaftex2026@gmail.com,founders@leaftex.bio

# Sender address. The leaftex.bio domain is verified in Resend, so use a branded sender:
CONTACT_FROM="LeafTex <no-reply@leaftex.bio>"
# (Before a domain is verified, Resend's sandbox sender can be used for testing, but it
#  only delivers to your own Resend account email:
#   CONTACT_FROM="LeafTex Website <onboarding@resend.dev>")
